# Copy to .env and fill in. .env is gitignored.

# the board's WebREPL, for deploy.sh (port optional, default 8266)
HOST=192.168.0.188:8266
HOST_SECRET=mypassword

# the home WiFi, for the board
WIFI_SSID=myssid
WIFI_PASSWORD=mypassword

# optional: listen for accent colors on this UDP port (see accent.py)
# ACCENT_PORT=4211
